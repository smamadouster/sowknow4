FROM python:3.11.11-slim

WORKDIR /app

# Minimal system deps (no OCR, no Whisper)
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 1001 appuser && useradd -g appuser -u 1001 -m appuser

# CPU-only PyTorch (200 MB vs 2 GB for full)
RUN pip install --no-cache-dir torch==2.1.0 --index-url https://download.pytorch.org/whl/cpu

COPY embed_server/requirements.txt /tmp/embed_requirements.txt
RUN pip install --no-cache-dir -r /tmp/embed_requirements.txt

# 2026-07-28: requirements install silently UPGRADES torch (sentence-transformers
# declares torch>=1.11.0 unpinned) — a rebuild pulled torch 2.13.0, which made
# CPU inference 30-60x slower on this host and froze the embed batcher queue.
# Force the pinned CPU wheel back AFTER requirements so the final state is
# guaranteed regardless of resolver drift.
RUN pip install --no-cache-dir --force-reinstall --no-deps torch==2.1.0 --index-url https://download.pytorch.org/whl/cpu

# Model cache dir — volume-mounted at runtime, NOT baked in
RUN mkdir -p /models && chown appuser:appuser /models

# Embed server source code
COPY embed_server/ /app/embed_server/
RUN chown -R appuser:appuser /app

ENV PYTHONPATH=/app
ENV SENTENCE_TRANSFORMERS_HOME=/models
ENV HF_HOME=/models
ENV TRANSFORMERS_CACHE=/models

USER appuser

# Single worker only: each uvicorn process loads the 1.3GB model independently.
# Bumping to 2+ workers would double memory usage.
# --limit-max-requests restarts the worker every 1000 requests to release
# accumulated PyTorch/NumPy memory pools that fragment over time.
CMD ["uvicorn", "embed_server.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--limit-max-requests", "1000"]
